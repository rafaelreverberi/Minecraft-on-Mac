+/* Use Microsoft's account claims, never blanket-grant privileges to a child. */
+static void update_account_policy( struct XUser *impl, IJsonObject *claims )
+{
+    XUserAgeGroup age = XUserAgeGroup_Unknown;
+    BOOLEAN privileges[1024] = {0}, known = FALSE;
+    HSTRING value = NULL;
+    IJsonArray *array = NULL;
+    IVector_IJsonValue *vector = NULL;
+    const WCHAR *text, *cursor;
+    WCHAR *end;
+    UINT32 count, i;
+    unsigned long privilege;
+    double number;
+
+    if (SUCCEEDED(get_json_string( claims, L"agg", &value )))
+    {
+        text = WindowsGetStringRawBuffer( value, NULL );
+        if (!wcscmp( text, L"Child" )) age = XUserAgeGroup_Child;
+        else if (!wcscmp( text, L"Teen" )) age = XUserAgeGroup_Teen;
+        else if (!wcscmp( text, L"Adult" )) age = XUserAgeGroup_Adult;
+        WindowsDeleteString( value );
+        value = NULL;
+    }
+    if (SUCCEEDED(get_json_string( claims, L"prv", &value )))
+    {
+        cursor = WindowsGetStringRawBuffer( value, NULL );
+        known = TRUE;
+        while (*cursor)
+        {
+            while (*cursor == ' ') ++cursor;
+            if (!*cursor) break;
+            if (*cursor < '0' || *cursor > '9') { known = FALSE; break; }
+            errno = 0;
+            privilege = wcstoul( cursor, &end, 10 );
+            if (errno || (*end && *end != ' ')) { known = FALSE; break; }
+            if (privilege < ARRAY_SIZE(privileges)) privileges[privilege] = TRUE;
+            cursor = end;
+        }
+        WindowsDeleteString( value );
+    }
+    else if (SUCCEEDED(get_json_array( claims, L"prv", &array )))
+    {
+        known = SUCCEEDED(IJsonArray_QueryInterface( array, &IID_IVector_IJsonValue, (void **)&vector )) &&
+            SUCCEEDED(IVector_IJsonValue_get_Size( vector, &count ));
+        for (i = 0; known && i < count; ++i)
+        {
+            if (FAILED(IJsonArray_GetNumberAt( array, i, &number )) || number < 0 ||
+                number > 4294967295.0 || number != (UINT32)number)
+                known = FALSE;
+            else if (number < ARRAY_SIZE(privileges)) privileges[(UINT32)number] = TRUE;
+        }
+        if (vector) IVector_IJsonValue_Release( vector );
+        IJsonArray_Release( array );
+    }
+    AcquireSRWLockExclusive( &impl->accountPolicyLock );
+    impl->ageGroup = age;
+    impl->privilegesKnown = known;
+    memcpy( impl->privileges, privileges, sizeof(privileges) );
+    ReleaseSRWLockExclusive( &impl->accountPolicyLock );
+}
